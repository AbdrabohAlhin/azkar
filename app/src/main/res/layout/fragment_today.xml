<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_beige"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/ic_card"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الثلاثاء، ٢٨ يوليو"
            android:textColor="@color/brown_medium"
            android:textSize="15sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اقتباس اليوم"
            android:textColor="@color/brown_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tvQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لا تحزن إن الله معنا"
            android:textColor="@color/brown_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="10dp"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/btnNewQuote"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="اقتباس جديد"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/ic_button_login" />

    </LinearLayout>

</RelativeLayout>