<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_beige"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="الإعدادات"
        android:textColor="@color/brown_dark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSettingsTitle"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <!-- حجم الخط -->
        <LinearLayout
            android:id="@+id/rowFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_card"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:layoutDirection="rtl"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="حجم الخط"
                android:textColor="@color/brown_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متوسط"
                android:textColor="@color/brown_medium"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- الوضع الليلي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_card"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الوضع الليلي"
                android:textColor="@color/brown_dark"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- التنبيهات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_card"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التنبيهات"
                android:textColor="@color/brown_dark"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- المساعدة والتعليمات -->
        <LinearLayout
            android:id="@+id/rowHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_card"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:layoutDirection="rtl">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="المساعدة والتعليمات"
                android:textColor="@color/brown_dark"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textColor="@color/brown_medium"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
